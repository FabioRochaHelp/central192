TRACCAR_CIRCUIT_BREAKER_THRESHOLD=3
TRACCAR_CIRCUIT_BREAKER_COOLDOWN_MINUTES=5

# Provedor de rastreamento ativo: traccar (padrão) ou ssx
TRACKING_PROVIDER=traccar

# SSX / SystemSatX — https://integration.systemsatx.com.br
