SSX_POSITIONS_SYNC_INTERVAL=60
SSX_CIRCUIT_BREAKER_THRESHOLD=3
SSX_CIRCUIT_BREAKER_COOLDOWN_MINUTES=5

# Cicatriz de incêndio (burn scar)
# Provedor: 'external' (serviço remoto) ou 'focos' (estimativa local pelos focos de calor)
BURNSCAR_PROVIDER=external
BURNSCAR_FOCOS_RADIUS_KM=15
BURNSCAR_FOCOS_WINDOW_DAYS=10
BURNSCAR_FOCOS_BUFFER_M=500

# Serviço externo de cicatriz de incêndio (usado quando BURNSCAR_PROVIDER=external)
BURNSCAR_BASE_URL=
BURNSCAR_ANALYZE_PATH=analyze
BURNSCAR_TOKEN=
BURNSCAR_TIMEOUT=60
BURNSCAR_VERIFY_SSL=true
BURNSCAR_CIRCUIT_BREAKER_THRESHOLD=3
BURNSCAR_CIRCUIT_BREAKER_COOLDOWN_MINUTES=5
